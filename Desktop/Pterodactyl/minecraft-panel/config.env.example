# Server Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://aetherpanel:secure_password_change_this@localhost:5432/aetherpanel?schema=public"
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-minimum-32-characters
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=your-refresh-token-secret-change-this-too

# Data Encryption
DATA_ENCRYPTION_KEY=your-256-bit-aes-encryption-key-change-this-in-production

# Minecraft Settings
DEFAULT_JAVA_PATH=java
DEFAULT_MINECRAFT_VERSION=1.20.1
DEFAULT_MEMORY=2048M
DEFAULT_PORT_RANGE_START=25565
DEFAULT_PORT_RANGE_END=25665

# Admin Settings (First Run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password-immediately
ADMIN_EMAIL=admin@aetherpanel.com

# File Upload Settings
MAX_FILE_SIZE=100000000
UPLOAD_PATH=./uploads

# Docker Settings
DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_NETWORK=aetherpanel-network

# SFTP Server
SFTP_PORT=2022
SFTP_HOST=localhost

# AWS S3 (Optional - for backups)
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=aetherpanel-backups

# InfluxDB (Optional - for metrics)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=aetherpanel
INFLUXDB_BUCKET=aetherpanel_metrics

# Plugin/Mod Repositories
MODRINTH_API_URL=https://api.modrinth.com/v2
CURSEFORGE_API_URL=https://api.curseforge.com/v1
SPIGOT_API_URL=https://api.spigotmc.org/legacy

# Backup Settings
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=900000

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Performance
MAX_CONNECTIONS=100
REQUEST_TIMEOUT=30000

# Security
BCRYPT_ROUNDS=12
SESSION_TIMEOUT=86400000
CSRF_SECRET=your-csrf-secret-key

# External Services (Optional)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your-webhook-id/your-token
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your-slack-webhook

# Feature Flags
ENABLE_METRICS=true
ENABLE_BACKUPS=true
ENABLE_PLUGINS=true
ENABLE_MODS=true
ENABLE_SFTP=true

# Development
DEBUG=false
DEV_TOOLS=true